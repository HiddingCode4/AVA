{
  "name": "ava-public",
  "version": "0.1.0",
  "private": true,
  "description": "AVA \u2014 compagnon vocal personnel",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis",
    "test": "node --test tests/*.cjs"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "fr.oreo.ava",
    "productName": "AVA",
    "files": [
      "main.cjs",
      "preload.cjs",
      "core.cjs",
      "ui/**/*",
      "biometrics/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}